{# fixture: minimal Qwen-lineage dialect with a DISTINCTIVE raise-guard —
   the accepted tuple ('high', 'medium', 'low') EXCLUDES 'xhigh', so any
   draft derived from this template must not propose an xhigh level (the
   "never propose a raise-guard-rejected level" property). Default is
   'medium'. No preserve knob, no vision. Polarity: 3.6/3.8 style
   (defined-false = nothink). #}
{%- set resolved_reasoning_effort = reasoning_effort|default('medium') %}
{%- if resolved_reasoning_effort not in ('high', 'medium', 'low') %}
    {{- raise_exception('Unexpected reasoning effort ' ~ resolved_reasoning_effort ~ '. Supported types are high (default fallback), medium, and low.') }}
{%- endif %}
{%- if add_generation_prompt %}
    {%- if enable_thinking is defined and enable_thinking is false %}
        {{- '<think>\n\n\n' }}
    {%- else %}
        {{- '<think>\n' }}
    {%- endif %}
{%- endif %}
