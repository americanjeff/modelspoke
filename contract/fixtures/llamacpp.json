    { "id": "gates/catalogEntry-gguf", "op": "llamacpp.isCatalogEntry", "suite": "the C10 catalog gates", "title": "isLlamacppCatalogEntry: the GGUF-meta half claims the origin", "input": { "entry": "$GGUF_META_ONLY_ENTRY" }, "expect": { "eq": true } },
    { "id": "gates/catalogEntry-llamaswap", "op": "llamacpp.isCatalogEntry", "suite": "the C10 catalog gates", "title": "isLlamacppCatalogEntry: the llama-swap entry claims nothing", "input": { "entry": "$LLAMA_SWAP_ENTRY" }, "expect": { "eq": false } },
    { "id": "gates/catalogEntry-bare", "op": "llamacpp.isCatalogEntry", "suite": "the C10 catalog gates", "title": "isLlamacppCatalogEntry: a bare entry claims nothing", "input": { "entry": "$BARE_ENTRY" }, "expect": { "eq": false } },

