    { "id": "gates/provenance-bare", "op": "llamacpp.hasLlamaSwapProvenance", "suite": "the C10 catalog gates", "title": "a bare entry carries no llama-swap provenance", "input": { "entry": "$BARE_ENTRY" }, "expect": { "eq": false } },

    { "id": "fetchProps/get-and-parse", "op": "llamacpp.fetchProps", "suite": "fetchLlamacppProps (GET {origin}/props)", "title": "GETs {origin}/props and passes the shape gate with the parsed payload", "input": { "origin": "http://127.0.0.1:8080" }, "fetch": [{ "when": { "pathSuffix": "/props" }, "reply": { "json": "$PROPS_FULL" } }], "expect": { "fields": { "props": "$PROPS_FULL", "inconclusive": null }, "calls": [{ "url": "http://127.0.0.1:8080/props", "method": "GET", "headers": { "Accept": "application/json" }, "notHeaders": ["Authorization"] }] } },
    { "id": "fetchProps/c7-bearer", "op": "llamacpp.fetchProps", "suite": "fetchLlamacppProps (GET {origin}/props)", "title": "rides the route's apiKey (C7): Authorization Bearer when set", "input": { "origin": "http://h:1", "apiKey": "sk-local" }, "fetch": [{ "when": { "pathSuffix": "/props" }, "reply": { "json": "$PROPS_FULL" } }], "expect": { "calls": [{ "headers": { "Authorization": "Bearer sk-local" } }] } },
    { "id": "fetchProps/404-definitive", "op": "llamacpp.fetchProps", "suite": "fetchLlamacppProps (GET {origin}/props)", "title": "404 is a DEFINITIVE non-match (C10's well-formed non-answers)", "input": { "origin": "http://h:1" }, "fetch": [{ "when": { "pathSuffix": "/props" }, "reply": { "status": 404, "text": "nope" } }], "expect": { "eq": {} } },
    { "id": "fetchProps/405-definitive", "op": "llamacpp.fetchProps", "suite": "fetchLlamacppProps (GET {origin}/props)", "title": "405 is a DEFINITIVE non-match", "input": { "origin": "http://h:1" }, "fetch": [{ "when": { "pathSuffix": "/props" }, "reply": { "status": 405, "text": "nope" } }], "expect": { "eq": {} } },
    { "id": "fetchProps/401-definitive", "op": "llamacpp.fetchProps", "suite": "fetchLlamacppProps (GET {origin}/props)", "title": "401 is a DEFINITIVE non-match", "input": { "origin": "http://h:1" }, "fetch": [{ "when": { "pathSuffix": "/props" }, "reply": { "status": 401, "text": "nope" } }], "expect": { "eq": {} } },
    { "id": "fetchProps/5xx-inconclusive-500", "op": "llamacpp.fetchProps", "suite": "fetchLlamacppProps (GET {origin}/props)", "title": "5xx is INCONCLUSIVE (not evidence)", "input": { "origin": "http://h:1" }, "fetch": [{ "when": { "pathSuffix": "/props" }, "reply": { "status": 500, "text": "boom" } }], "expect": { "eq": { "inconclusive": true } } },
    { "id": "fetchProps/5xx-inconclusive-502", "op": "llamacpp.fetchProps", "input": { "origin": "http://h:1" }, "fetch": [{ "when": { "pathSuffix": "/props" }, "reply": { "status": 502, "text": "boom" } }], "expect": { "eq": { "inconclusive": true } } },
    { "id": "fetchProps/5xx-inconclusive-503", "op": "llamacpp.fetchProps", "input": { "origin": "http://h:1" }, "fetch": [{ "when": { "pathSuffix": "/props" }, "reply": { "status": 503, "text": "boom" } }], "expect": { "eq": { "inconclusive": true } } },
    { "id": "fetchProps/network-inconclusive", "op": "llamacpp.fetchProps", "input": { "origin": "http://h:1" }, "fetch": [{ "when": { "pathSuffix": "/props" }, "reply": { "throw": "network" } }], "expect": { "eq": { "inconclusive": true } } },
    { "id": "fetchProps/abort-inconclusive", "op": "llamacpp.fetchProps", "input": { "origin": "http://h:1", "signal": "preaborted" }, "fetch": [{ "when": { "pathSuffix": "/props" }, "reply": { "throw": "abort" } }], "expect": { "eq": { "inconclusive": true } } },
    { "id": "fetchProps/non-props-kobold-shape", "op": "llamacpp.fetchProps", "input": { "origin": "http://h:1" }, "fetch": [{ "when": { "pathSuffix": "/props" }, "reply": { "json": { "n_ctx": 8192, "chat_template": "…", "modalities": { "vision": true } } } }], "expect": { "eq": {} } },
    { "id": "fetchProps/non-props-dgs-string", "op": "llamacpp.fetchProps", "input": { "origin": "http://h:1" }, "fetch": [{ "when": { "pathSuffix": "/props" }, "reply": { "json": { "default_generation_settings": "not-an-object" } } }], "expect": { "eq": {} } },
    { "id": "fetchProps/non-props-dgs-null", "op": "llamacpp.fetchProps", "input": { "origin": "http://h:1" }, "fetch": [{ "when": { "pathSuffix": "/props" }, "reply": { "json": { "default_generation_settings": null } } }], "expect": { "eq": {} } },
    { "id": "fetchProps/non-props-array", "op": "llamacpp.fetchProps", "input": { "origin": "http://h:1" }, "fetch": [{ "when": { "pathSuffix": "/props" }, "reply": { "json": [1, 2] } }], "expect": { "eq": {} } },
    { "id": "fetchProps/non-props-string-body", "op": "llamacpp.fetchProps", "input": { "origin": "http://h:1" }, "fetch": [{ "when": { "pathSuffix": "/props" }, "reply": { "json": "ok" } }], "expect": { "eq": {} } },
    { "id": "fetchProps/non-json-200-definitive", "op": "llamacpp.fetchProps", "input": { "origin": "http://h:1" }, "fetch": [{ "when": { "pathSuffix": "/props" }, "reply": { "text": "{ not json" } }], "expect": { "eq": {} } },
    { "id": "fetchProps/hostile-origin-inconclusive", "op": "llamacpp.fetchProps", "input": { "origin": "" }, "fetch": [{ "when": { "pathSuffix": "/props" }, "reply": { "throw": "network" } }], "expect": { "fields": { "inconclusive": true } } },

    { "id": "map/ctx-prefers-configured", "op": "llamacpp.propsToCanonical", "suite": "llamacppPropsToCanonical: contextWindow (the two-layer preference)", "title": "prefers default_generation_settings.n_ctx (AS CONFIGURED) over meta.n_ctx_train", "input": { "props": "$PROPS_FULL", "entry": "$LLAMACPP_OWNED_ENTRY" }, "expect": { "fields": { "discoveredCanonical.contextWindow": 4096 } } },
    { "id": "map/ctx-falls-to-train", "op": "llamacpp.propsToCanonical", "input": { "props": "$PROPS_OLD_SERVER", "entry": "$LLAMACPP_OWNED_ENTRY" }, "expect": { "fields": { "discoveredCanonical.contextWindow": 2048 } } },
    { "id": "map/ctx-bad-0-falls-to-train", "op": "llamacpp.propsToCanonical", "input": { "props": "$PROPS_CTX_0", "entry": "$LLAMACPP_OWNED_ENTRY" }, "expect": { "fields": { "discoveredCanonical.contextWindow": 131072 } } },
    { "id": "map/ctx-bad-negative-falls-to-train", "op": "llamacpp.propsToCanonical", "input": { "props": "$PROPS_CTX_NEG", "entry": "$LLAMACPP_OWNED_ENTRY" }, "expect": { "fields": { "discoveredCanonical.contextWindow": 131072 } } },
    { "id": "map/ctx-bad-float-falls-to-train", "op": "llamacpp.propsToCanonical", "input": { "props": "$PROPS_CTX_FLOAT", "entry": "$LLAMACPP_OWNED_ENTRY" }, "expect": { "fields": { "discoveredCanonical.contextWindow": 131072 } } },
    { "id": "map/ctx-bad-string-falls-to-train", "op": "llamacpp.propsToCanonical", "input": { "props": "$PROPS_CTX_STRING", "entry": "$LLAMACPP_OWNED_ENTRY" }, "expect": { "fields": { "discoveredCanonical.contextWindow": 131072 } } },
    { "id": "map/ctx-bad-null-falls-to-train", "op": "llamacpp.propsToCanonical", "input": { "props": "$PROPS_CTX_NULL", "entry": "$LLAMACPP_OWNED_ENTRY" }, "expect": { "fields": { "discoveredCanonical.contextWindow": 131072 } } },
    { "id": "map/ctx-invalid-no-meta-omitted", "op": "llamacpp.propsToCanonical", "input": { "props": "$PROPS_INVALID_CTX", "entry": "$BARE_ENTRY" }, "expect": { "fields": { "discoveredCanonical": null } } },
    { "id": "map/c6-failed-props-emits-train-ctx", "op": "llamacpp.propsToCanonical", "suite": "llamacppPropsToCanonical: contextWindow (the two-layer preference)", "title": "C6: a FAILED /props (undefined) still emits the fetch-free meta.n_ctx_train contextWindow", "input": { "props": null, "entry": "$LLAMACPP_OWNED_ENTRY" }, "expect": { "fields": { "discoveredCanonical": { "contextWindow": 131072 } } } },
    { "id": "map/c6-failed-props-no-meta-nothing", "op": "llamacpp.propsToCanonical", "input": { "props": null, "entry": "$BARE_ENTRY" }, "expect": { "fields": { "discoveredCanonical": null } } },
    { "id": "map/coerce-digit-string-nctx", "op": "llamacpp.propsToCanonical", "suite": "llamacppPropsToCanonical: contextWindow (the two-layer preference)", "title": "coerces digit strings and rejects non-integers through toPositiveInt (props side)", "input": { "props": "$PROPS_STRING_CTX", "entry": "$BARE_ENTRY" }, "expect": { "fields": { "discoveredCanonical.contextWindow": 8192 } } },
    { "id": "map/coerce-digit-string-train", "op": "llamacpp.propsToCanonical", "input": { "props": null, "entry": "$ENTRY_TRAIN_STRING" }, "expect": { "fields": { "discoveredCanonical.contextWindow": 131072 } } },
    { "id": "map/coerce-float-train-invalid", "op": "llamacpp.propsToCanonical", "input": { "props": null, "entry": "$ENTRY_TRAIN_FLOAT" }, "expect": { "fields": { "discoveredCanonical": null } } },
    { "id": "map/mirror-only-not-in-chain", "op": "llamacpp.propsToCanonical", "input": { "props": null, "entry": { "id": "m", "meta": { "n_ctx": 4096 } } }, "expect": { "fields": { "discoveredCanonical": null } } },
    { "id": "map/input-vision-true", "op": "llamacpp.propsToCanonical", "suite": "llamacppPropsToCanonical: input (modalities.vision)", "title": "vision true → ['text','image']", "input": { "props": "$PROPS_FULL", "entry": "$BARE_ENTRY" }, "expect": { "fields": { "discoveredCanonical.input": ["text", "image"] } } },
    { "id": "map/input-vision-false", "op": "llamacpp.propsToCanonical", "input": { "props": "$PROPS_NO_VISION_NO_EFFORT", "entry": "$BARE_ENTRY" }, "expect": { "fields": { "discoveredCanonical.input": ["text"] } } },
    { "id": "map/input-absent-old-server", "op": "llamacpp.propsToCanonical", "input": { "props": "$PROPS_OLD_SERVER", "entry": "$BARE_ENTRY" }, "expect": { "fields": { "discoveredCanonical.input": null } } },
    { "id": "map/input-malformed-modalities", "op": "llamacpp.propsToCanonical", "input": { "props": "$PROPS_MODALITIES_MALFORMED", "entry": "$BARE_ENTRY" }, "expect": { "fields": { "discoveredCanonical.input": null } } },
    { "id": "map/c6-failed-props-input-only-context", "op": "llamacpp.propsToCanonical", "input": { "props": null, "entry": "$LLAMACPP_OWNED_ENTRY" }, "expect": { "fields": { "discoveredCanonical": { "contextWindow": 131072 } } } },
    { "id": "map/caps-effort-true", "op": "llamacpp.propsToCanonical", "suite": "llamacppPropsToCanonical: the caps boolean gate (the ONE C5 compat exception)", "title": "supports_reasoning_effort true → compat true AND reasoning true", "input": { "props": "$PROPS_FULL", "entry": "$BARE_ENTRY" }, "expect": { "fields": { "discoveredCanonical.compat": { "supportsReasoningEffort": true }, "discoveredCanonical.reasoning": true } } },
    { "id": "map/caps-effort-false-no-reasoning", "op": "llamacpp.propsToCanonical", "input": { "props": "$PROPS_NO_VISION_NO_EFFORT", "entry": "$BARE_ENTRY" }, "expect": { "fields": { "discoveredCanonical.compat": { "supportsReasoningEffort": false }, "discoveredCanonical.reasoning": null } } },
    { "id": "map/caps-absent-old-server", "op": "llamacpp.propsToCanonical", "input": { "props": "$PROPS_OLD_SERVER", "entry": "$BARE_ENTRY" }, "expect": { "eq": { "discoveredCanonical": { "contextWindow": 2048 } }, "fields": { "discoveredCanonical.compat": null } } },
    { "id": "map/caps-malformed-empty", "op": "llamacpp.propsToCanonical", "input": { "props": "$PROPS_CAPS_EMPTY", "entry": "$BARE_ENTRY" }, "expect": { "fields": { "discoveredCanonical.compat": null, "discoveredCanonical.reasoning": null } } },
    { "id": "map/caps-malformed-string", "op": "llamacpp.propsToCanonical", "input": { "props": "$PROPS_CAPS_STRING", "entry": "$BARE_ENTRY" }, "expect": { "fields": { "discoveredCanonical.compat": null, "discoveredCanonical.reasoning": null } } },
    { "id": "map/caps-malformed-number", "op": "llamacpp.propsToCanonical", "input": { "props": "$PROPS_CAPS_NUMBER", "entry": "$BARE_ENTRY" }, "expect": { "fields": { "discoveredCanonical.compat": null, "discoveredCanonical.reasoning": null } } },
    { "id": "map/caps-malformed-null", "op": "llamacpp.propsToCanonical", "input": { "props": "$PROPS_CAPS_NULL", "entry": "$BARE_ENTRY" }, "expect": { "fields": { "discoveredCanonical.compat": null, "discoveredCanonical.reasoning": null } } },
    { "id": "map/never-emits-maxTokens-thinkingLevelMap", "op": "llamacpp.propsToCanonical", "suite": "llamacppPropsToCanonical: the never-emits (C5 + the jinja capture-out-of-scope)", "title": "never emits maxTokens or thinkingLevelMap, however much /props carries", "input": { "props": "$PROPS_DECOYS", "entry": "$LLAMACPP_OWNED_ENTRY" }, "expect": { "fields": { "discoveredCanonical": { "defined": true }, "discoveredCanonical.maxTokens": null, "discoveredCanonical.thinkingLevelMap": null } } },
    { "id": "map/jinja-never-propagated", "op": "llamacpp.propsToCanonical", "input": { "props": "$PROPS_FULL", "entry": "$BARE_ENTRY" }, "expect": { "jsonNotContains": ["chat_template", "jinja"] } },

    { "id": "rows/props-answered-server-wide", "op": "llamacpp.rowsById", "suite": "llamacppRowsById (the pure seam, C4 semantics)", "title": "props answered: EVERY entry is enriched (router mode — server-wide values)", "input": { "entries": ["$LLAMACPP_OWNED_ENTRY", "$GGUF_META_ONLY_ENTRY", "$BARE_ENTRY"], "props": "$PROPS_FULL" }, "expect": { "byIdSize": 3, "byId": [{ "id": "Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf", "canonical": { "contextWindow": 4096, "input": ["text", "image"], "compat": { "supportsReasoningEffort": true }, "reasoning": true } }, { "id": "qwen3.8-8b-Q4_K_M.gguf", "canonical": { "contextWindow": 4096, "input": ["text", "image"], "compat": { "supportsReasoningEffort": true }, "reasoning": true } }, { "id": "gemma-4-E4B-it", "canonical": { "contextWindow": 4096, "input": ["text", "image"], "compat": { "supportsReasoningEffort": true }, "reasoning": true } }] } },
    { "id": "rows/minimal-props-bare-undefined", "op": "llamacpp.rowsById", "title": "props with no usable fields: bare entries are enriched-nothing (undefined values)", "input": { "entries": ["$LLAMACPP_OWNED_ENTRY", "$BARE_ENTRY"], "props": { "default_generation_settings": {} } }, "expect": { "byIdSize": 2, "byId": [{ "id": "Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf", "canonical": { "contextWindow": 131072 } }, { "id": "gemma-4-E4B-it", "canonical": null }] } },
    { "id": "rows/props-failed-train-fallback-only", "op": "llamacpp.rowsById", "title": "props failed: only the fetch-free meta.n_ctx_train fallback applies", "input": { "entries": ["$LLAMACPP_OWNED_ENTRY", "$GGUF_META_ONLY_ENTRY", "$BARE_ENTRY"], "props": null }, "expect": { "byId": [{ "id": "Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf", "canonical": { "contextWindow": 131072 } }, { "id": "qwen3.8-8b-Q4_K_M.gguf", "canonical": { "contextWindow": 131072 } }], "byIdAbsent": ["gemma-4-E4B-it"] } },
    { "id": "rows/mirror-only-absent", "op": "llamacpp.rowsById", "title": "an entry with only the as-configured mirror (no n_ctx_train) keeps the generic row when props failed", "input": { "entries": [{ "id": "m", "meta": { "n_ctx": 4096 } }], "props": null }, "expect": { "byIdSize": 0 } },
    { "id": "rows/empty-catalog", "op": "llamacpp.rowsById", "title": "an empty catalog resolves an empty map", "input": { "entries": [], "props": "$PROPS_FULL" }, "expect": { "byIdSize": 0 } },

    { "id": "detectVerdict/catalog-owned-by-zero-fetch", "op": "llamacpp.detect", "suite": "llamacppBackend.detect — the catalog-first ZERO-fetch matches", "title": "matches on owned_by === 'llamacpp' without any fetch", "input": { "baseUrl": "http://127.0.0.1:8080/v1", "entries": ["$LLAMACPP_OWNED_ENTRY"] }, "fetch": [{ "when": { "pathSuffix": "/props" }, "reply": { "throw": "network" } }], "expect": { "eq": { "match": true, "facts": {} }, "fetchCount": 0 } },
    { "id": "detectVerdict/catalog-gguf-zero-fetch", "op": "llamacpp.detect", "title": "matches on a GGUF meta object (non-llama-swap) without any fetch", "input": { "baseUrl": "http://127.0.0.1:8080/v1", "entries": ["$GGUF_META_ONLY_ENTRY"] }, "fetch": [{ "when": { "pathSuffix": "/props" }, "reply": { "throw": "network" } }], "expect": { "eq": { "match": true, "facts": {} }, "fetchCount": 0 } },
    { "id": "detectVerdict/llamaswap-guard-zero-fetch", "op": "llamacpp.detect", "title": "FALSE-POSITIVE GUARD: a llama-swap catalog (meta.llamaswap) is a ZERO-fetch definitive no", "input": { "baseUrl": "http://127.0.0.1:8080/v1", "entries": ["$LLAMA_SWAP_ENTRY", "$BARE_ENTRY"] }, "fetch": [{ "when": { "pathSuffix": "/props" }, "reply": { "throw": "network" } }], "expect": { "eq": { "match": false }, "fetchCount": 0 } },
    { "id": "detectVerdict/shape-gate-bare-nctx-probes", "op": "llamacpp.detect", "title": "FALSE-POSITIVE GUARD (shape gate): a bare n_ctx-only meta does NOT catalog-match — it falls through to the probe, never a zero-fetch claim", "input": { "baseUrl": "http://127.0.0.1:8080/v1", "entries": [{ "id": "m", "object": "model", "created": 1, "meta": { "n_ctx": 4096 } }] }, "fetch": [{ "when": { "pathSuffix": "/props" }, "reply": { "status": 404, "text": "not found" } }], "expect": { "fields": { "match": false, "inconclusive": null }, "fetchCount": 1 } },
    { "id": "detectVerdict/llamaswap-mixed-shape-guard", "op": "llamacpp.detect", "title": "FALSE-POSITIVE GUARD: the mixed live shape (bare n_ctx meta + a meta.llamaswap entry) is a ZERO-fetch definitive no", "input": { "baseUrl": "http://127.0.0.1:8080/v1", "entries": [{ "id": "a", "object": "model", "created": 1, "meta": { "n_ctx": 4096 } }, "$LLAMA_SWAP_ENTRY"] }, "fetch": [{ "when": { "pathSuffix": "/props" }, "reply": { "throw": "network" } }], "expect": { "eq": { "match": false }, "fetchCount": 0 } },
    { "id": "detectVerdict/llamaswap-definitive-unreachable-props", "op": "llamacpp.detect", "title": "FALSE-POSITIVE GUARD: the llama-swap verdict is definitive even when /props would be unreachable", "input": { "baseUrl": "http://127.0.0.1:8080/v1", "entries": ["$LLAMA_SWAP_ENTRY"] }, "fetch": [{ "when": { "pathSuffix": "/props" }, "reply": { "throw": "network" } }], "expect": { "eq": { "match": false }, "fields": { "inconclusive": null }, "fetchCount": 0 } },
    { "id": "detectVerdict/probe-match-caches-facts", "op": "llamacpp.detect", "suite": "llamacppBackend.detect — the ONE probe (bare-shape catalogs)", "title": "matches on the /props shape and caches the payload in facts (the reuse contract)", "input": { "baseUrl": "http://127.0.0.1:8080/v1", "entries": ["$BARE_ENTRY"] }, "fetch": [{ "when": { "pathSuffix": "/props" }, "reply": { "json": "$PROPS_FULL" } }], "expect": { "fields": { "match": true, "facts.props": "$PROPS_FULL" }, "fetchCount": 1 } },
    { "id": "detectVerdict/404-definitive", "op": "llamacpp.detect", "title": "404 → a DEFINITIVE non-match", "input": { "baseUrl": "http://127.0.0.1:8080/v1", "entries": ["$BARE_ENTRY"] }, "fetch": [{ "when": { "pathSuffix": "/props" }, "reply": { "status": 404, "text": "nope" } }], "expect": { "eq": { "match": false } } },
    { "id": "detectVerdict/405-definitive", "op": "llamacpp.detect", "title": "405 → a DEFINITIVE non-match", "input": { "baseUrl": "http://127.0.0.1:8080/v1", "entries": ["$BARE_ENTRY"] }, "fetch": [{ "when": { "pathSuffix": "/props" }, "reply": { "status": 405, "text": "nope" } }], "expect": { "eq": { "match": false } } },
    { "id": "detectVerdict/401-definitive", "op": "llamacpp.detect", "title": "401 → a DEFINITIVE non-match", "input": { "baseUrl": "http://127.0.0.1:8080/v1", "entries": ["$BARE_ENTRY"] }, "fetch": [{ "when": { "pathSuffix": "/props" }, "reply": { "status": 401, "text": "nope" } }], "expect": { "eq": { "match": false } } },
    { "id": "detectVerdict/5xx-inconclusive", "op": "llamacpp.detect", "title": "5xx → INCONCLUSIVE (retriable)", "input": { "baseUrl": "http://127.0.0.1:8080/v1", "entries": ["$BARE_ENTRY"] }, "fetch": [{ "when": { "pathSuffix": "/props" }, "reply": { "status": 500, "text": "boom" } }], "expect": { "eq": { "match": false, "inconclusive": true } } },
    { "id": "detectVerdict/network-inconclusive", "op": "llamacpp.detect", "title": "network failure → INCONCLUSIVE (retriable)", "input": { "baseUrl": "http://127.0.0.1:8080/v1", "entries": ["$BARE_ENTRY"] }, "fetch": [{ "when": { "pathSuffix": "/props" }, "reply": { "throw": "network" } }], "expect": { "eq": { "match": false, "inconclusive": true } } },
    { "id": "detectVerdict/non-props-200-definitive", "op": "llamacpp.detect", "title": "a 200 non-props body (KoboldCpp's /props) → a definitive non-match", "input": { "baseUrl": "http://127.0.0.1:8080/v1", "entries": ["$BARE_ENTRY"] }, "fetch": [{ "when": { "pathSuffix": "/props" }, "reply": { "json": { "n_ctx": 8192, "chat_template": "…" } } }], "expect": { "eq": { "match": false } } },
    { "id": "detectVerdict/c7-bearer", "op": "llamacpp.detect", "title": "the probe rides the route's apiKey (C7)", "input": { "baseUrl": "http://127.0.0.1:8080/v1", "entries": ["$BARE_ENTRY"], "apiKey": "sk-local" }, "fetch": [{ "when": { "pathSuffix": "/props" }, "reply": { "json": "$PROPS_FULL" } }], "expect": { "calls": [{ "headers": { "Authorization": "Bearer sk-local" } }] } }
  ]
}