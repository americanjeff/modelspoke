    { "id": "gates/gguf-core-key-beside-nctx", "op": "llamacpp.hasGgufMeta", "suite": "the C10 catalog gates", "title": "a real GGUF meta matches on ANY core shape key, even beside n_ctx", "input": { "entry": { "id": "m", "meta": { "n_ctx": 4096, "n_ctx_train": 131072 } } }, "expect": { "eq": true } },
