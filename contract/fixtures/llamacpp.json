  "vectors": [
    { "id": "origin/strips-trailing-v1", "op": "llamacpp.origin", "suite": "llamacppOrigin", "title": "strips the trailing /v1 from a normalized route base", "input": { "base": "http://127.0.0.1:8080/v1" }, "expect": { "eq": "http://127.0.0.1:8080" } },
    { "id": "origin/strips-trailing-v1-slash", "op": "llamacpp.origin", "suite": "llamacppOrigin", "title": "strips /v1/ with the trailing slash", "input": { "base": "http://127.0.0.1:8080/v1/" }, "expect": { "eq": "http://127.0.0.1:8080" } },
    { "id": "origin/strips-api-v1", "op": "llamacpp.origin", "suite": "llamacppOrigin", "title": "strips /v1 after another segment", "input": { "base": "http://host/api/v1" }, "expect": { "eq": "http://host/api" } },
    { "id": "origin/strips-only-one-v1", "op": "llamacpp.origin", "suite": "llamacppOrigin", "title": "strips only ONE /v1", "input": { "base": "http://host/v1/v1" }, "expect": { "eq": "http://host/v1" } },
    { "id": "origin/no-v1-passthrough", "op": "llamacpp.origin", "suite": "llamacppOrigin", "title": "defensively passes a base that does not end in /v1 through", "input": { "base": "http://127.0.0.1:8080" }, "expect": { "eq": "http://127.0.0.1:8080" } },
    { "id": "origin/no-v1-slash-stripped", "op": "llamacpp.origin", "suite": "llamacppOrigin", "title": "defensively passes a non-/v1 base through (slash-stripped)", "input": { "base": "http://127.0.0.1:8080/" }, "expect": { "eq": "http://127.0.0.1:8080" } },

    { "id": "gates/ownedBy-llamacpp", "op": "llamacpp.isOwnedBy", "suite": "the C10 catalog gates", "title": "isLlamacppOwnedBy: exactly the owned_by === 'llamacpp' spelling (the owned entry)", "input": { "entry": "$LLAMACPP_OWNED_ENTRY" }, "expect": { "eq": true } },
    { "id": "gates/ownedBy-bare", "op": "llamacpp.isOwnedBy", "suite": "the C10 catalog gates", "title": "isLlamacppOwnedBy: a bare entry does not match", "input": { "entry": "$BARE_ENTRY" }, "expect": { "eq": false } },
    { "id": "gates/ownedBy-llamaswap", "op": "llamacpp.isOwnedBy", "suite": "the C10 catalog gates", "title": "isLlamacppOwnedBy: the llama-swap entry does not match", "input": { "entry": "$LLAMA_SWAP_ENTRY" }, "expect": { "eq": false } },
    { "id": "gates/ownedBy-gguf-only", "op": "llamacpp.isOwnedBy", "suite": "the C10 catalog gates", "title": "isLlamacppOwnedBy: a GGUF-meta entry without the marker does not match", "input": { "entry": "$GGUF_META_ONLY_ENTRY" }, "expect": { "eq": false } },

    { "id": "gates/gguf-owned-entry", "op": "llamacpp.hasGgufMeta", "suite": "the C10 catalog gates", "title": "hasLlamacppGgufMeta: the owned GGUF entry matches", "input": { "entry": "$LLAMACPP_OWNED_ENTRY" }, "expect": { "eq": true } },
    { "id": "gates/gguf-meta-without-owned-by", "op": "llamacpp.hasGgufMeta", "suite": "the C10 catalog gates", "title": "a GGUF meta object EXCLUDING llama-swap's authored block matches (older/passthrough shapes)", "input": { "entry": "$GGUF_META_ONLY_ENTRY" }, "expect": { "eq": true } },
    { "id": "gates/gguf-false-positive-guard", "op": "llamacpp.hasGgufMeta", "suite": "the C10 catalog gates", "title": "FALSE-POSITIVE GUARD: meta.llamaswap is llama-swap's authored provenance, not the GGUF meta — even with the mirrored meta.n_ctx beside it", "input": { "entry": "$LLAMA_SWAP_ENTRY" }, "expect": { "eq": false } },
    { "id": "gates/gguf-llamaswap-block-only", "op": "llamacpp.hasGgufMeta", "suite": "the C10 catalog gates", "title": "a meta.llamaswap block alone never matches", "input": { "entry": { "id": "m", "meta": { "llamaswap": { "type": "model" } } } }, "expect": { "eq": false } },
    { "id": "gates/gguf-bare", "op": "llamacpp.hasGgufMeta", "suite": "the C10 catalog gates", "title": "a bare entry (no meta) never matches", "input": { "entry": "$BARE_ENTRY" }, "expect": { "eq": false } },
    { "id": "gates/gguf-no-meta", "op": "llamacpp.hasGgufMeta", "suite": "the C10 catalog gates", "title": "an entry without meta never matches", "input": { "entry": { "id": "m" } }, "expect": { "eq": false } },
    { "id": "gates/gguf-meta-array", "op": "llamacpp.hasGgufMeta", "suite": "the C10 catalog gates", "title": "a non-object (array) meta never matches", "input": { "entry": { "id": "m", "meta": [] } }, "expect": { "eq": false } },
    { "id": "gates/gguf-shape-gate-nctx-only", "op": "llamacpp.hasGgufMeta", "suite": "the C10 catalog gates", "title": "SHAPE-GATED: a bare meta with only n_ctx (llama-swap's live shape) never matches", "input": { "entry": { "id": "m", "meta": { "n_ctx": 4096 } } }, "expect": { "eq": false } },
