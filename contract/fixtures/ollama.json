    { "id": "origin/strips-only-one-v1", "op": "ollama.origin", "input": { "base": "http://host/v1/v1" }, "expect": { "eq": "http://host/v1" } },
    { "id": "origin/no-v1-passthrough", "op": "ollama.origin", "input": { "base": "http://127.0.0.1:11434" }, "expect": { "eq": "http://127.0.0.1:11434" } },
    { "id": "origin/no-v1-slash-stripped", "op": "ollama.origin", "input": { "base": "http://127.0.0.1:11434/" }, "expect": { "eq": "http://127.0.0.1:11434" } },

    { "id": "probeVersion/get-and-parse", "op": "ollama.probeVersion", "input": { "origin": "http://127.0.0.1:11434" }, "fetch": [{ "when": { "pathSuffix": "/api/version" }, "reply": { "json": { "version": "0.32.15" } } }], "expect": { "eq": { "isOllama": true, "version": "0.32.15" }, "calls": [{ "url": "http://127.0.0.1:11434/api/version" }] } },
    { "id": "probeVersion/multi-segment-verbatim", "op": "ollama.probeVersion", "input": { "origin": "http://h:1" }, "fetch": [{ "when": { "pathSuffix": "/api/version" }, "reply": { "json": { "version": "0.6.12.3" } } }], "expect": { "eq": { "isOllama": true, "version": "0.6.12.3" } } },
    { "id": "probeVersion/shape-not-dotted", "op": "ollama.probeVersion", "input": { "origin": "http://h:1" }, "fetch": [{ "when": { "pathSuffix": "/api/version" }, "reply": { "json": { "version": "not-dotted" } } }], "expect": { "eq": { "isOllama": false } } },
    { "id": "probeVersion/shape-non-numeric-segment", "op": "ollama.probeVersion", "input": { "origin": "http://h:1" }, "fetch": [{ "when": { "pathSuffix": "/api/version" }, "reply": { "json": { "version": "0.32.x" } } }], "expect": { "eq": { "isOllama": false } } },
    { "id": "probeVersion/shape-number", "op": "ollama.probeVersion", "input": { "origin": "http://h:1" }, "fetch": [{ "when": { "pathSuffix": "/api/version" }, "reply": { "json": { "version": 42 } } }], "expect": { "eq": { "isOllama": false } } },
    { "id": "probeVersion/shape-missing", "op": "ollama.probeVersion", "input": { "origin": "http://h:1" }, "fetch": [{ "when": { "pathSuffix": "/api/version" }, "reply": { "json": {} } }], "expect": { "eq": { "isOllama": false } } },
    { "id": "probeVersion/shape-wrong-key", "op": "ollama.probeVersion", "input": { "origin": "http://h:1" }, "fetch": [{ "when": { "pathSuffix": "/api/version" }, "reply": { "json": { "v": "0.32.15" } } }], "expect": { "eq": { "isOllama": false } } },
    { "id": "probeVersion/shape-array", "op": "ollama.probeVersion", "input": { "origin": "http://h:1" }, "fetch": [{ "when": { "pathSuffix": "/api/version" }, "reply": { "json": [] } }], "expect": { "eq": { "isOllama": false } } },
    { "id": "probeVersion/404-definitive", "op": "ollama.probeVersion", "input": { "origin": "http://h:1" }, "fetch": [{ "when": { "pathSuffix": "/api/version" }, "reply": { "status": 404, "text": "nope" } }], "expect": { "eq": { "isOllama": false } } },
    { "id": "probeVersion/non-json-200-definitive", "op": "ollama.probeVersion", "input": { "origin": "http://h:1" }, "fetch": [{ "when": { "pathSuffix": "/api/version" }, "reply": { "text": "{ not json" } }], "expect": { "eq": { "isOllama": false } } },
    { "id": "probeVersion/network-inconclusive", "op": "ollama.probeVersion", "input": { "origin": "http://h:1" }, "fetch": [{ "when": { "pathSuffix": "/api/version" }, "reply": { "throw": "network" } }], "expect": { "eq": { "isOllama": false, "inconclusive": true } } },
