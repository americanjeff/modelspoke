    { "id": "showBatch/fail-soft-omits-failed", "op": "ollama.showBatch", "input": { "origin": "http://h:1", "ids": ["a", "bad", "c"] }, "fetch": [{ "when": { "pathSuffix": "/api/show", "bodyJson": { "model": "bad" } }, "reply": { "status": 500, "json": {} } }, { "when": { "pathSuffix": "/api/show" }, "reply": { "json": { "capabilities": [] } } }], "expect": { "byIdKeys": ["a", "c"] } },
    { "id": "showBatch/empty-ids-empty-map", "op": "ollama.showBatch", "input": { "origin": "http://h:1", "ids": [] }, "fetch": [{ "when": { "pathSuffix": "/api/show" }, "reply": { "json": {} } }], "expect": { "byIdSize": 0 } },

    { "id": "metadataRows/entry-order-full", "op": "ollama.metadataRows", "input": { "entries": "$ENTRIES", "shows": { "gemma4:e4b": "$SHOW_GEMMA4_E4B", "qwen3-coder-200k:latest": "$SHOW_QWEN3CODER", "glm-5.2:cloud": "$SHOW_GLM_CLOUD" }, "serverVersion": "0.32.15" }, "expect": { "gated": [], "rows": [ { "id": "gemma4:e4b", "discoveredCanonical": { "reasoning": true, "input": ["text", "image"], "contextWindow": 131072, "thinkingLevelMap": "$GEMMA4_MAP" } }, { "id": "qwen3-coder-200k:latest", "discoveredCanonical": { "contextWindow": 262144 } }, { "id": "glm-5.2:cloud", "discoveredCanonical": { "reasoning": true, "contextWindow": 1048576, "thinkingLevelMap": "$CLOUD_GLM_MAP" } } ] } },
    { "id": "metadataRows/failed-show-generic-fallback", "op": "ollama.metadataRows", "input": { "entries": "$ENTRIES", "shows": { "gemma4:e4b": "$SHOW_GEMMA4_E4B" } }, "expect": { "fields": { "rows.1": { "id": "qwen3-coder-200k:latest" }, "rows.0.discoveredCanonical": { "defined": true }, "rows.2": { "id": "glm-5.2:cloud" } } } },
    { "id": "metadataRows/generic-fallback-llamaswap-meta", "op": "ollama.metadataRows", "input": { "entries": ["$META_ENTRY"], "shows": {} }, "expect": { "rows": [ { "id": "gemma4:e4b", "discoveredCanonical": { "reasoning": true, "contextWindow": 4096 } } ] } },
    { "id": "metadataRows/gated-ids", "op": "ollama.metadataRows", "input": { "entries": "$ENTRIES_GEMMA_QWEN", "shows": { "gemma4:e4b": "$SHOW_GEMMA4_E4B", "qwen3-coder-200k:latest": "$SHOW_QWEN3CODER" }, "serverVersion": "0.15.5" }, "expect": { "gated": ["gemma4:e4b"], "fields": { "rows.0.discoveredCanonical.thinkingLevelMap": null, "rows.0.discoveredCanonical.reasoning": true, "rows.0.discoveredCanonical.contextWindow": 131072 } } },

    { "id": "detect/guard-meta-llamaswap-zero-fetches", "op": "ollama.detect", "input": { "baseUrl": "http://127.0.0.1:8080/v1", "entries": [{ "id": "m", "object": "model", "created": 1, "meta": { "llamaswap": { "type": "model" }, "n_ctx": 4096 } }] }, "fetch": [{ "when": { "pathSuffix": "/api/version" }, "reply": { "json": { "version": "0.32.15" } } }], "expect": { "eq": { "match": false }, "fetchCount": 0 } },
    { "id": "detect/guard-owned-by-llama-swap", "op": "ollama.detect", "input": { "baseUrl": "http://127.0.0.1:8080/v1", "entries": [{ "id": "m", "object": "model", "created": 1, "owned_by": "llama-swap" }] }, "fetch": [{ "when": { "pathSuffix": "/api/version" }, "reply": { "json": { "version": "0.32.15" } } }], "expect": { "eq": { "match": false }, "fetchCount": 0 } },
    { "id": "detect/bare-catalog-still-probes-and-matches", "op": "ollama.detect", "input": { "baseUrl": "http://127.0.0.1:8080/v1", "entries": [{ "id": "m", "object": "model", "created": 1 }] }, "fetch": [{ "when": { "pathSuffix": "/api/version" }, "reply": { "json": { "version": "0.32.15" } } }], "expect": { "fields": { "match": true, "facts": { "version": "0.32.15" } }, "fetchCount": 1 } }
