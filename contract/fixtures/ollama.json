    { "id": "show/post-and-parse", "op": "ollama.show", "input": { "origin": "http://127.0.0.1:11434", "id": "gemma4:e4b" }, "fetch": [{ "when": { "pathSuffix": "/api/show" }, "reply": { "json": "$SHOW_GEMMA4_E4B" } }], "expect": { "eq": "$SHOW_GEMMA4_E4B", "calls": [{ "url": "http://127.0.0.1:11434/api/show", "method": "POST", "headers": { "Content-Type": "application/json" }, "bodyJson": { "model": "gemma4:e4b" } }] } },
    { "id": "show/404-undefined", "op": "ollama.show", "input": { "origin": "http://h:1", "id": "nonexistent:latest" }, "fetch": [{ "when": { "pathSuffix": "/api/show" }, "reply": { "status": 404, "json": { "error": "model 'nonexistent:latest' not found" } } }], "expect": { "eq": null } },
