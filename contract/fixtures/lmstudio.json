    { "id": "probeModels/c7-no-key", "op": "lmstudio.probeModels", "suite": "fetchLmStudioModels (§3.1 detection, C7/C10)", "title": "sends no Authorization header when the apiKey is absent", "input": { "origin": "http://127.0.0.1:1234" }, "fetch": [{ "reply": { "json": "$V1_LIST_BODY" } }], "expect": { "calls": [{ "notHeaders": ["Authorization"] }] } },
    { "id": "probeModels/shape-empty-object", "op": "lmstudio.probeModels", "suite": "fetchLmStudioModels (§3.1 detection, C7/C10)", "title": "rejects wrong shapes as a DEFINITIVE non-match (the wrap + keyed-element gate) — {}", "input": { "origin": "http://h:1" }, "fetch": [{ "reply": { "json": {} } }], "expect": { "eq": { "isLmStudio": false } } },
    { "id": "probeModels/shape-empty-models", "op": "lmstudio.probeModels", "suite": "fetchLmStudioModels (§3.1 detection, C7/C10)", "title": "rejects wrong shapes — an element-less list cannot confirm the dialect", "input": { "origin": "http://h:1" }, "fetch": [{ "reply": { "json": { "models": [] } } }], "expect": { "eq": { "isLmStudio": false } } },
    { "id": "probeModels/shape-models-numbers", "op": "lmstudio.probeModels", "suite": "fetchLmStudioModels (§3.1 detection, C7/C10)", "title": "rejects wrong shapes — { models: [1,2,3] }", "input": { "origin": "http://h:1" }, "fetch": [{ "reply": { "json": { "models": [1, 2, 3] } } }], "expect": { "eq": { "isLmStudio": false } } },
    { "id": "probeModels/shape-models-no-key", "op": "lmstudio.probeModels", "suite": "fetchLmStudioModels (§3.1 detection, C7/C10)", "title": "rejects wrong shapes — { models: [{ name: no-key }] }", "input": { "origin": "http://h:1" }, "fetch": [{ "reply": { "json": { "models": [{ "name": "no-key" }] } } }], "expect": { "eq": { "isLmStudio": false } } },
    { "id": "probeModels/shape-models-key-number", "op": "lmstudio.probeModels", "suite": "fetchLmStudioModels (§3.1 detection, C7/C10)", "title": "rejects wrong shapes — { models: [{ key: 42 }] }", "input": { "origin": "http://h:1" }, "fetch": [{ "reply": { "json": { "models": [{ "key": 42 }] } } }], "expect": { "eq": { "isLmStudio": false } } },
    { "id": "probeModels/shape-models-string", "op": "lmstudio.probeModels", "suite": "fetchLmStudioModels (§3.1 detection, C7/C10)", "title": "rejects wrong shapes — { models: \"yes\" }", "input": { "origin": "http://h:1" }, "fetch": [{ "reply": { "json": { "models": "yes" } } }], "expect": { "eq": { "isLmStudio": false } } },
    { "id": "probeModels/shape-openai-wrapper", "op": "lmstudio.probeModels", "suite": "fetchLmStudioModels (§3.1 detection, C7/C10)", "title": "rejects wrong shapes — the OpenAI wrapper is NOT the marker", "input": { "origin": "http://h:1" }, "fetch": [{ "reply": { "json": { "data": [{ "id": "openai-shape" }] } } }], "expect": { "eq": { "isLmStudio": false } } },
    { "id": "probeModels/shape-array", "op": "lmstudio.probeModels", "suite": "fetchLmStudioModels (§3.1 detection, C7/C10)", "title": "rejects wrong shapes — []", "input": { "origin": "http://h:1" }, "fetch": [{ "reply": { "json": [] } }], "expect": { "eq": { "isLmStudio": false } } },
    { "id": "probeModels/shape-string", "op": "lmstudio.probeModels", "suite": "fetchLmStudioModels (§3.1 detection, C7/C10)", "title": "rejects wrong shapes — \"ok\"", "input": { "origin": "http://h:1" }, "fetch": [{ "reply": { "json": "ok" } }], "expect": { "eq": { "isLmStudio": false } } },
    { "id": "probeModels/non-json-200", "op": "lmstudio.probeModels", "suite": "fetchLmStudioModels (§3.1 detection, C7/C10)", "title": "non-JSON 200 answers are a definitive non-match", "input": { "origin": "http://h:1" }, "fetch": [{ "reply": { "text": "{ not json", "status": 200 } }], "expect": { "eq": { "isLmStudio": false } } },
    { "id": "probeModels/401-definitive", "op": "lmstudio.probeModels", "suite": "fetchLmStudioModels (§3.1 detection, C7/C10)", "title": "401 is a DEFINITIVE non-match (C10)", "input": { "origin": "http://h:1" }, "fetch": [{ "reply": { "text": "nope", "status": 401 } }], "expect": { "eq": { "isLmStudio": false } } },
    { "id": "probeModels/404-definitive", "op": "lmstudio.probeModels", "suite": "fetchLmStudioModels (§3.1 detection, C7/C10)", "title": "404 (pre-0.4.0 v0-only servers) is a DEFINITIVE non-match (C10)", "input": { "origin": "http://h:1" }, "fetch": [{ "reply": { "text": "nope", "status": 404 } }], "expect": { "eq": { "isLmStudio": false } } },
    { "id": "probeModels/405-definitive", "op": "lmstudio.probeModels", "suite": "fetchLmStudioModels (§3.1 detection, C7/C10)", "title": "405 (pre-0.4.0 v0-only servers) is a DEFINITIVE non-match (C10)", "input": { "origin": "http://h:1" }, "fetch": [{ "reply": { "text": "nope", "status": 405 } }], "expect": { "eq": { "isLmStudio": false } } },
    { "id": "probeModels/5xx-inconclusive-500", "op": "lmstudio.probeModels", "suite": "fetchLmStudioModels (§3.1 detection, C7/C10)", "title": "5xx and unlisted statuses are INCONCLUSIVE (500)", "input": { "origin": "http://h:1" }, "fetch": [{ "reply": { "text": "nope", "status": 500 } }], "expect": { "eq": { "isLmStudio": false, "inconclusive": true } } },
    { "id": "probeModels/5xx-inconclusive-502", "op": "lmstudio.probeModels", "suite": "fetchLmStudioModels (§3.1 detection, C7/C10)", "title": "5xx and unlisted statuses are INCONCLUSIVE (502)", "input": { "origin": "http://h:1" }, "fetch": [{ "reply": { "text": "nope", "status": 502 } }], "expect": { "eq": { "isLmStudio": false, "inconclusive": true } } },
    { "id": "probeModels/5xx-inconclusive-503", "op": "lmstudio.probeModels", "suite": "fetchLmStudioModels (§3.1 detection, C7/C10)", "title": "5xx and unlisted statuses are INCONCLUSIVE (503)", "input": { "origin": "http://h:1" }, "fetch": [{ "reply": { "text": "nope", "status": 503 } }], "expect": { "eq": { "isLmStudio": false, "inconclusive": true } } },
    { "id": "probeModels/unlisted-inconclusive-403", "op": "lmstudio.probeModels", "suite": "fetchLmStudioModels (§3.1 detection, C7/C10)", "title": "unlisted statuses are INCONCLUSIVE (403)", "input": { "origin": "http://h:1" }, "fetch": [{ "reply": { "text": "nope", "status": 403 } }], "expect": { "eq": { "isLmStudio": false, "inconclusive": true } } },
    { "id": "probeModels/unlisted-inconclusive-418", "op": "lmstudio.probeModels", "suite": "fetchLmStudioModels (§3.1 detection, C7/C10)", "title": "unlisted statuses are INCONCLUSIVE (418)", "input": { "origin": "http://h:1" }, "fetch": [{ "reply": { "text": "nope", "status": 418 } }], "expect": { "eq": { "isLmStudio": false, "inconclusive": true } } },
    { "id": "probeModels/network-inconclusive", "op": "lmstudio.probeModels", "suite": "fetchLmStudioModels (§3.1 detection, C7/C10)", "title": "a network failure is an INCONCLUSIVE non-match (retriable)", "input": { "origin": "http://h:1" }, "fetch": [{ "reply": { "throw": "network" } }], "expect": { "eq": { "isLmStudio": false, "inconclusive": true } } },
    { "id": "probeModels/abort-inconclusive", "op": "lmstudio.probeModels", "suite": "fetchLmStudioModels (§3.1 detection, C7/C10)", "title": "never throws, even when fetchImpl rejects with an abort", "input": { "origin": "http://h:1", "signal": "preaborted" }, "fetch": [{ "reply": { "throw": "abort" } }], "expect": { "fields": { "isLmStudio": false, "inconclusive": true } } },
    { "id": "payload/wrapped-keyed-shape", "op": "lmstudio.payloadGate", "suite": "lmStudioModelsPayload (the shape gate, unit-tested)", "title": "returns the raw element array only for the wrapped keyed shape (the docs list)", "input": { "payload": "$V1_LIST_BODY" }, "expect": { "eq": "$V1_MODELS" } },
    { "id": "payload/mixed-elements-pass-through", "op": "lmstudio.payloadGate", "suite": "lmStudioModelsPayload (the shape gate, unit-tested)", "title": "returns the raw element array including non-object elements (the join filters them)", "input": { "payload": { "models": [{ "key": "a" }, 42, null] } }, "expect": { "eq": [{ "key": "a" }, 42, null] } },
    { "id": "payloadGate/empty-models-array", "op": "lmstudio.payloadGate", "suite": "lmStudioModelsPayload (the shape gate, unit-tested)", "title": "an element-less list cannot confirm the dialect — undefined", "input": { "payload": { "models": [] } }, "expect": { "eq": null } },
    { "id": "payloadGate/openai-wrapper-undefined", "op": "lmstudio.payloadGate", "suite": "lmStudioModelsPayload (the shape gate, unit-tested)", "title": "the OpenAI wrapper is NOT the marker — undefined", "input": { "payload": { "data": [] } }, "expect": { "eq": null } },
    { "id": "payloadGate/null-payload", "op": "lmstudio.payloadGate", "suite": "lmStudioModelsPayload (the shape gate, unit-tested)", "title": "a null payload → undefined", "input": { "payload": null }, "expect": { "eq": null } },
    { "id": "detectVerdict/match-with-facts", "op": "lmstudio.detect", "suite": "lmstudioBackend.detect (verdict mapping)", "title": "a matching shape → match with the parsed elements as facts (the §3.2 cache)", "input": { "baseUrl": "http://127.0.0.1:1234/v1", "entries": "$CATALOG_ENTRIES" }, "fetch": [{ "reply": { "json": "$V1_LIST_BODY" } }], "expect": { "fields": { "match": true, "inconclusive": null, "facts.models": "$V1_MODELS" } } },
    { "id": "detectVerdict/404-definitive", "op": "lmstudio.detect", "suite": "lmstudioBackend.detect (verdict mapping)", "title": "a definitive non-match (404) → { match: false }", "input": { "baseUrl": "http://127.0.0.1:1234/v1", "entries": "$CATALOG_ENTRIES" }, "fetch": [{ "reply": { "text": "nope", "status": 404 } }], "expect": { "eq": { "match": false } } },
    { "id": "detectVerdict/wrong-shape-definitive", "op": "lmstudio.detect", "suite": "lmstudioBackend.detect (verdict mapping)", "title": "a definitive non-match (wrong shape) → { match: false }", "input": { "baseUrl": "http://127.0.0.1:1234/v1", "entries": "$CATALOG_ENTRIES" }, "fetch": [{ "reply": { "json": { "data": [] } } }], "expect": { "eq": { "match": false } } },
    { "id": "detectVerdict/network-inconclusive", "op": "lmstudio.detect", "suite": "lmstudioBackend.detect (verdict mapping)", "title": "a network failure → { match: false, inconclusive: true }", "input": { "baseUrl": "http://127.0.0.1:1234/v1", "entries": "$CATALOG_ENTRIES" }, "fetch": [{ "reply": { "throw": "network" } }], "expect": { "eq": { "match": false, "inconclusive": true } } },
    { "id": "detectVerdict/c7-bearer", "op": "lmstudio.detect", "suite": "lmstudioBackend.detect (verdict mapping)", "title": "the route's apiKey rides the detection probe (C7)", "input": { "baseUrl": "http://127.0.0.1:1234/v1", "entries": "$CATALOG_ENTRIES", "apiKey": "sk-test" }, "fetch": [{ "reply": { "json": "$V1_LIST_BODY" } }], "expect": { "calls": [{ "headers": { "Authorization": "Bearer sk-test" } }] } },
    { "id": "enrich/join-facts-cache-zero-fetches", "op": "lmstudio.enrich", "suite": "lmstudioBackend.metadataRows (the §3.2 same-response join)", "title": "joins by key === entry.id with ZERO extra fetches when the facts cache rides", "input": { "entries": "$CATALOG_ENTRIES", "baseUrl": "http://127.0.0.1:1234/v1", "facts": { "models": "$V1_MODELS" } }, "fetch": [{ "reply": { "throw": "network" } }], "expect": { "fetchCount": 0, "notes": null, "byIdSize": 3, "byId": [{ "id": "google/gemma-4-26b-a4b", "canonical": { "reasoning": true, "input": ["text", "image"], "contextWindow": 4096, "thinkingLevelMap": "$OFF_ONLY_TOGGLE_MAP" } }, { "id": "qwen/qwen3.8-27b", "canonical": { "reasoning": true, "input": ["text"], "contextWindow": 262144, "thinkingLevelMap": "$FULL_GRADED_MAP" } }, { "id": "text-embedding-nomic-embed", "canonical": null }] } },
    { "id": "enrich/no-matching-element-absent", "op": "lmstudio.enrich", "suite": "lmstudioBackend.metadataRows (the §3.2 same-response join)", "title": "a catalog id with no matching model element stays ABSENT (the generic row survives)", "input": { "entries": [{ "id": "google/gemma-4-26b-a4b", "object": "model", "created": 1, "owned_by": "lmstudio" }, { "id": "not-in-the-v1-list", "object": "model", "created": 2, "owned_by": "lmstudio" }], "baseUrl": "http://127.0.0.1:1234/v1", "facts": { "models": "$V1_MODELS" } }, "fetch": [{ "reply": { "throw": "network" } }], "expect": { "byId": [{ "id": "google/gemma-4-26b-a4b", "canonical": { "reasoning": true, "input": ["text", "image"], "contextWindow": 4096, "thinkingLevelMap": "$OFF_ONLY_TOGGLE_MAP" } }], "byIdAbsent": ["not-in-the-v1-list"] } },
    { "id": "enrich/malformed-element-stays-generic", "op": "lmstudio.enrich", "suite": "lmstudioBackend.metadataRows (the §3.2 same-response join)", "title": "a malformed element cannot be joined — that id stays generic", "input": { "entries": "$CATALOG_ENTRIES", "baseUrl": "http://127.0.0.1:1234/v1", "facts": { "models": [{ "key": 42 }, "broken", "$MODEL_QWEN_GRADED"] } }, "fetch": [{ "reply": { "throw": "network" } }], "expect": { "byIdAbsent": ["google/gemma-4-26b-a4b", "text-embedding-nomic-embed"], "byId": [{ "id": "qwen/qwen3.8-27b", "canonical": { "reasoning": true, "input": ["text"], "contextWindow": 262144, "thinkingLevelMap": "$FULL_GRADED_MAP" } }] } },
    { "id": "enrich/refetch-once-without-facts", "op": "lmstudio.enrich", "suite": "lmstudioBackend.metadataRows (the §3.2 same-response join)", "title": "without a facts cache it re-fetches the same URL ONCE (the defensive direct-call path)", "input": { "entries": "$CATALOG_ENTRIES", "baseUrl": "http://127.0.0.1:1234/v1" }, "fetch": [{ "reply": { "json": "$V1_LIST_BODY" } }], "expect": { "fetchCount": 1, "calls": [{ "url": "http://127.0.0.1:1234/api/v1/models" }], "byIdFields": { "qwen/qwen3.8-27b": { "reasoning": { "defined": true } } } } },
    { "id": "enrich/fail-soft-network", "op": "lmstudio.enrich", "suite": "lmstudioBackend.metadataRows (the §3.2 same-response join)", "title": "fail-soft: a failed re-fetch → { byId: empty }, never throws (network)", "input": { "entries": "$CATALOG_ENTRIES", "baseUrl": "http://127.0.0.1:1234/v1" }, "fetch": [{ "reply": { "throw": "network" } }], "expect": { "byIdSize": 0 } },
    { "id": "enrich/fail-soft-404", "op": "lmstudio.enrich", "suite": "lmstudioBackend.metadataRows (the §3.2 same-response join)", "title": "fail-soft: a 404 re-fetch → { byId: new Map() }", "input": { "entries": "$CATALOG_ENTRIES", "baseUrl": "http://127.0.0.1:1234/v1" }, "fetch": [{ "reply": { "text": "nope", "status": 404 } }], "expect": { "byIdSize": 0 } },
    { "id": "enrich/fail-soft-empty-models", "op": "lmstudio.enrich", "suite": "lmstudioBackend.metadataRows (the §3.2 same-response join)", "title": "fail-soft: a non-matching answer → { byId: new Map() }", "input": { "entries": "$CATALOG_ENTRIES", "baseUrl": "http://127.0.0.1:1234/v1" }, "fetch": [{ "reply": { "json": { "models": [] } } }], "expect": { "byIdSize": 0 } },
    { "id": "enrich/refetch-signal-and-key", "op": "lmstudio.enrich", "suite": "lmstudioBackend.metadataRows (the §3.2 same-response join)", "title": "the re-fetch honors the caller's signal and apiKey (C7)", "input": { "entries": "$CATALOG_ENTRIES", "baseUrl": "http://127.0.0.1:1234/v1", "apiKey": "sk-live", "signal": "given" }, "fetch": [{ "reply": { "json": "$V1_LIST_BODY" } }], "expect": { "calls": [{ "headers": { "Authorization": "Bearer sk-live" }, "signal": "given" }] } }
  ]
