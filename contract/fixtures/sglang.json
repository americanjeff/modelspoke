    { "id": "probe/non-json-200", "op": "sglang.probeModelInfo", "suite": "probeSglangModelInfo (§5.1 detection)", "title": "a 200 with malformed JSON is a definitive no", "input": { "origin": "http://h:1" }, "fetch": [{ "reply": { "text": "{ not json", "status": 200 } }], "expect": { "eq": { "isSglang": false } } },
    { "id": "probe/alias-fallback", "op": "sglang.probeModelInfo", "suite": "probeSglangModelInfo (§5.1 detection)", "title": "the deprecated alias is tried ONCE, and ONLY after a 404 of the new name (§5.1)", "input": { "origin": "http://127.0.0.1:30000" }, "fetch": [{ "when": { "pathSuffix": "/model_info" }, "reply": { "text": "nope", "status": 404 } }, { "when": { "pathSuffix": "/get_model_info" }, "reply": { "json": "$MODEL_INFO_FULL" } }], "expect": { "eq": { "isSglang": true, "modelInfo": "$MODEL_INFO_FULL" }, "urls": ["http://127.0.0.1:30000/model_info", "http://127.0.0.1:30000/get_model_info"] } },
    { "id": "probe/alias-body-cached", "op": "sglang.probeModelInfo", "suite": "probeSglangModelInfo (§5.1 detection)", "title": "an alias match caches the ALIAS body (the facts.modelInfo source for old servers)", "input": { "origin": "http://h:1" }, "fetch": [{ "when": { "pathSuffix": "/get_model_info" }, "reply": { "json": "$LEGACY_ALIAS_BODY" } }, { "when": { "pathSuffix": "/model_info" }, "reply": { "text": "nope", "status": 404 } }], "expect": { "fields": { "modelInfo": "$LEGACY_ALIAS_BODY" } } },
    { "id": "probe/404-both-names", "op": "sglang.probeModelInfo", "suite": "probeSglangModelInfo (§5.1 detection)", "title": "404 on BOTH names → definitive no (exactly two probes)", "input": { "origin": "http://h:1" }, "fetch": [{ "reply": { "text": "nope", "status": 404 } }], "expect": { "eq": { "isSglang": false }, "fetchCount": 2 } },
    { "id": "probe/alias-wrong-shape-200", "op": "sglang.probeModelInfo", "suite": "probeSglangModelInfo (§5.1 detection)", "title": "a 200-wrong-shape from the alias (after a 404) is still a definitive no", "input": { "origin": "http://h:1" }, "fetch": [{ "reply": { "json": { "nope": true } } }], "expect": { "eq": { "isSglang": false } } },
    { "id": "probe/405-definitive-no-alias", "op": "sglang.probeModelInfo", "suite": "probeSglangModelInfo (§5.1 detection)", "title": "405 on the new name → definitive no WITHOUT trying the alias (C10)", "input": { "origin": "http://h:1" }, "fetch": [{ "reply": { "text": "nope", "status": 405 } }], "expect": { "eq": { "isSglang": false }, "fetchCount": 1 } },
    { "id": "probe/401-definitive-no-alias", "op": "sglang.probeModelInfo", "suite": "probeSglangModelInfo (§5.1 detection)", "title": "401 on the new name → definitive no WITHOUT trying the alias (C10)", "input": { "origin": "http://h:1" }, "fetch": [{ "reply": { "text": "nope", "status": 401 } }], "expect": { "eq": { "isSglang": false }, "fetchCount": 1 } },
    { "id": "probe/5xx-new-name-inconclusive", "op": "sglang.probeModelInfo", "suite": "probeSglangModelInfo (§5.1 detection)", "title": "5xx on the new name → INCONCLUSIVE (no alias attempt, retriable)", "input": { "origin": "http://h:1" }, "fetch": [{ "reply": { "json": { "error": "boom" }, "status": 503 } }], "expect": { "eq": { "isSglang": false, "inconclusive": true }, "fetchCount": 1 } },
    { "id": "probe/5xx-alias-inconclusive", "op": "sglang.probeModelInfo", "suite": "probeSglangModelInfo (§5.1 detection)", "title": "5xx on the alias (after a 404 on the new name) → INCONCLUSIVE", "input": { "origin": "http://h:1" }, "fetch": [{ "when": { "pathSuffix": "/model_info" }, "reply": { "text": "nope", "status": 404 } }, { "when": { "pathSuffix": "/get_model_info" }, "reply": { "json": { "error": "boom" }, "status": 500 } }], "expect": { "eq": { "isSglang": false, "inconclusive": true }, "fetchCount": 2 } },
    { "id": "probe/network-failure-inconclusive", "op": "sglang.probeModelInfo", "suite": "probeSglangModelInfo (§5.1 detection)", "title": "a network failure is an INCONCLUSIVE not-SGLang (retriable)", "input": { "origin": "http://h:1" }, "fetch": [{ "reply": { "throw": "network" } }], "expect": { "eq": { "isSglang": false, "inconclusive": true } } },
    { "id": "probe/abort-inconclusive", "op": "sglang.probeModelInfo", "suite": "probeSglangModelInfo (§5.1 detection)", "title": "never throws, even when fetchImpl rejects with an abort", "input": { "origin": "http://h:1", "signal": "preaborted" }, "fetch": [{ "reply": { "throw": "abort" } }], "expect": { "fields": { "isSglang": false, "inconclusive": true } } },
    { "id": "probe/c7-bearer-header", "op": "sglang.probeModelInfo", "suite": "probeSglangModelInfo (§5.1 detection)", "title": "C7: the route's apiKey rides the probe as a Bearer header (—api-key protects ALL endpoints)", "input": { "origin": "http://h:1", "apiKey": "sekrit" }, "fetch": [{ "reply": { "json": "$MODEL_INFO_FULL" } }], "expect": { "calls": [{ "headers": { "Authorization": "Bearer sekrit" } }] } },
    { "id": "probe/c7-no-key-no-header", "op": "sglang.probeModelInfo", "suite": "probeSglangModelInfo (§5.1 detection)", "title": "C7: no key → no Authorization header at all", "input": { "origin": "http://h:1" }, "fetch": [{ "reply": { "json": "$MODEL_INFO_FULL" } }], "expect": { "calls": [{ "notHeaders": ["Authorization"] }] } },
    { "id": "serverInfo/get-and-parse", "op": "sglang.fetchServerInfo", "suite": "fetchSglangServerInfo (the one optional enrichment fetch)", "title": "GETs {origin}/server_info and returns the parsed object", "input": { "origin": "http://127.0.0.1:30000" }, "fetch": [{ "reply": { "json": "$SERVER_INFO" } }], "expect": { "eq": "$SERVER_INFO", "fetchCount": 1, "calls": [{ "url": "http://127.0.0.1:30000/server_info" }] } },
    { "id": "serverInfo/c7-bearer-no-alias", "op": "sglang.fetchServerInfo", "suite": "fetchSglangServerInfo (the one optional enrichment fetch)", "title": "C7: the apiKey rides it; no /get_server_info alias is probed (one fetch, fail-soft stop)", "input": { "origin": "http://h:1", "apiKey": "sekrit" }, "fetch": [{ "reply": { "text": "nope", "status": 404 } }], "expect": { "eq": null, "fetchCount": 1, "neverSuffixes": ["/get_server_info"], "calls": [{ "headers": { "Authorization": "Bearer sekrit" } }] } },
    { "id": "serverInfo/5xx-fail-soft", "op": "sglang.fetchServerInfo", "suite": "fetchSglangServerInfo (the one optional enrichment fetch)", "title": "non-2xx → undefined (never throws)", "input": { "origin": "http://h:1" }, "fetch": [{ "reply": { "json": { "error": "boom" }, "status": 500 } }], "expect": { "eq": null } },
    { "id": "serverInfo/network-fail-soft", "op": "sglang.fetchServerInfo", "suite": "fetchSglangServerInfo (the one optional enrichment fetch)", "title": "network failure → undefined (never throws)", "input": { "origin": "http://h:1" }, "fetch": [{ "reply": { "throw": "network" } }], "expect": { "eq": null } },
    { "id": "serverInfo/broken-json-fail-soft", "op": "sglang.fetchServerInfo", "suite": "fetchSglangServerInfo (the one optional enrichment fetch)", "title": "non-JSON 200 → undefined (never throws)", "input": { "origin": "http://h:1" }, "fetch": [{ "reply": { "text": "{ broken", "status": 200 } }], "expect": { "eq": null } },
    { "id": "serverInfo/array-body-fail-soft", "op": "sglang.fetchServerInfo", "suite": "fetchSglangServerInfo (the one optional enrichment fetch)", "title": "non-object body → undefined (never throws)", "input": { "origin": "http://h:1" }, "fetch": [{ "reply": { "json": [1, 2] } }], "expect": { "eq": null } },
    { "id": "rowsById/server-wide-across-entries", "op": "sglang.rowsById", "suite": "sglangRowsById (server-wide facts across entries, C4 replacement)", "title": "applies the server-wide facts to EVERY entry; the entry's own max_model_len wins per entry", "input": { "entries": "$ENTRIES", "modelInfo": "$MODEL_INFO_FULL", "serverInfo": "$SERVER_INFO" }, "expect": { "byIdSize": 2, "byId": [{ "id": "qwen2.5-vl-7b", "canonical": { "reasoning": true, "input": ["text", "image"], "contextWindow": 32768 } }, { "id": "qwen25-7b-instruct", "canonical": { "reasoning": true, "input": ["text", "image"], "contextWindow": 262144 } }] } },
    { "id": "rowsById/enriched-nothing-undefined-values", "op": "sglang.rowsById", "suite": "sglangRowsById (server-wide facts across entries, C4 replacement)", "title": "every entry id is present even when nothing maps (undefined = enriched, nothing found)", "input": { "entries": "$BARE_PAIR_NO_LEN", "modelInfo": "$MODEL_INFO_04X" }, "expect": { "byIdSize": 2, "byId": [{ "id": "qwen2.5-vl-7b", "canonical": null }, { "id": "qwen25-7b-instruct", "canonical": null }] } },
    { "id": "enrich/never-refetch-model-info", "op": "sglang.enrich", "suite": "sglangBackend.metadataRows (the C4 facts contract over the fetch log)", "title": "NEVER re-fetches /model_info — detection's facts carry the body (C4, fetch call log)", "input": { "entries": "$ENTRIES", "baseUrl": "http://127.0.0.1:30000/v1", "facts": { "modelInfo": "$MODEL_INFO_FULL" } }, "fetch": [{ "reply": { "json": "$SERVER_INFO" } }], "expect": { "neverSuffixes": ["/model_info", "/get_model_info"], "suffixCounts": [{ "suffix": "/server_info", "count": 1 }], "byIdFields": { "qwen25-7b-instruct": { "contextWindow": 262144 } } } },
    { "id": "enrich/server-info-not-needed-silent", "op": "sglang.enrich", "suite": "sglangBackend.metadataRows (the C4 facts contract over the fetch log)", "title": "fetches /server_info ONLY when ≥1 entry lacks a positive max_model_len (every entry self-sufficient)", "input": { "entries": ["$ENTRY_WITH_MAX_MODEL_LEN"], "baseUrl": "http://127.0.0.1:30000/v1", "facts": { "modelInfo": "$MODEL_INFO_FULL" } }, "fetch": [{ "reply": { "throw": "network" } }], "expect": { "fetchCount": 0 } },
    { "id": "enrich/server-info-needed-once", "op": "sglang.enrich", "suite": "sglangBackend.metadataRows (the C4 facts contract over the fetch log)", "title": "fetches /server_info ONLY when ≥1 entry lacks a positive max_model_len (one entry lacked it → one fetch)", "input": { "entries": "$ENTRIES", "baseUrl": "http://127.0.0.1:30000/v1", "facts": { "modelInfo": "$MODEL_INFO_FULL" } }, "fetch": [{ "reply": { "json": "$SERVER_INFO" } }], "expect": { "fetchCount": 1 } },
    { "id": "enrich/server-info-failure-stops-chain", "op": "sglang.enrich", "suite": "sglangBackend.metadataRows (the C4 facts contract over the fetch log)", "title": "a /server_info failure stops the chain at the entry value; reasoning/input still map (§5.5)", "input": { "entries": "$ENTRIES", "baseUrl": "http://127.0.0.1:30000/v1", "facts": { "modelInfo": "$MODEL_INFO_FULL" } }, "fetch": [{ "reply": { "json": { "error": "boom" }, "status": 500 } }], "expect": { "fetchCount": 1, "byId": [{ "id": "qwen2.5-vl-7b", "canonical": { "reasoning": true, "input": ["text", "image"], "contextWindow": 32768 } }, { "id": "qwen25-7b-instruct", "canonical": { "reasoning": true, "input": ["text", "image"] } }] } },
    { "id": "enrich/facts-undefined-all-generic", "op": "sglang.enrich", "suite": "sglangBackend.metadataRows (the C4 facts contract over the fetch log)", "title": "missing/malformed facts.modelInfo → ALL-GENERIC (empty byId, zero fetches) — facts undefined", "input": { "entries": "$ENTRIES", "baseUrl": "http://127.0.0.1:30000/v1" }, "fetch": [{ "reply": { "json": "$SERVER_INFO" } }], "expect": { "byIdSize": 0, "fetchCount": 0 } },
    { "id": "enrich/facts-empty-object", "op": "sglang.enrich", "suite": "sglangBackend.metadataRows (the C4 facts contract over the fetch log)", "title": "missing/malformed facts.modelInfo → ALL-GENERIC (empty byId, zero fetches) — facts {}", "input": { "entries": "$ENTRIES", "baseUrl": "http://127.0.0.1:30000/v1", "facts": {} }, "fetch": [{ "reply": { "json": "$SERVER_INFO" } }], "expect": { "byIdSize": 0, "fetchCount": 0 } },
    { "id": "enrich/facts-model-info-junk", "op": "sglang.enrich", "suite": "sglangBackend.metadataRows (the C4 facts contract over the fetch log)", "title": "missing/malformed facts.modelInfo → ALL-GENERIC (facts.modelInfo \"junk\")", "input": { "entries": "$ENTRIES", "baseUrl": "http://127.0.0.1:30000/v1", "facts": { "modelInfo": "junk" } }, "fetch": [{ "reply": { "json": "$SERVER_INFO" } }], "expect": { "byIdSize": 0, "fetchCount": 0 } },
    { "id": "enrich/facts-model-info-array", "op": "sglang.enrich", "suite": "sglangBackend.metadataRows (the C4 facts contract over the fetch log)", "title": "missing/malformed facts.modelInfo → ALL-GENERIC (facts.modelInfo [1,2])", "input": { "entries": "$ENTRIES", "baseUrl": "http://127.0.0.1:30000/v1", "facts": { "modelInfo": [1, 2] } }, "fetch": [{ "reply": { "json": "$SERVER_INFO" } }], "expect": { "byIdSize": 0, "fetchCount": 0 } },
    { "id": "enrich/c7-api-key-rides", "op": "sglang.enrich", "suite": "sglangBackend.metadataRows (the C4 facts contract over the fetch log)", "title": "the ctx apiKey rides the /server_info fetch (C7)", "input": { "entries": "$ENTRIES", "baseUrl": "http://127.0.0.1:30000/v1", "apiKey": "sekrit", "facts": { "modelInfo": "$MODEL_INFO_FULL" } }, "fetch": [{ "reply": { "json": "$SERVER_INFO" } }], "expect": { "calls": [{ "urlSuffix": "/server_info", "headers": { "Authorization": "Bearer sekrit" } }], "byIdFields": { "qwen25-7b-instruct": { "contextWindow": 262144 } } } }
  ]
